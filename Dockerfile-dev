FROM node:24-bookworm AS node

WORKDIR /src
# Node 24 still provides Corepack's Yarn shims; Node 25+ does not. Remove the
# shims so the same explicitly pinned Yarn installation works on both.
RUN rm -f /usr/local/bin/yarn /usr/local/bin/yarnpkg \
 && npm install --global yarn@1.22.22
COPY . /src
RUN yarn install --frozen-lockfile --flat

FROM python:3.14

RUN mkdir -p /srv
WORKDIR /srv
COPY . /srv
COPY --from=node /src/dienst2/static/lib /srv/dienst2/static/lib
RUN pip install "poetry==2.4.3"

# Keep project dependencies out of Poetry's own environment. /opt/venv is not
# hidden by Docker Compose's /srv bind mount.
RUN python -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
RUN poetry install --with dev --no-root
RUN set -a && . ./dev.env && python manage.py collectstatic --noinput --no-post-process

ENTRYPOINT ["/srv/docker-entrypoint-dev.sh"]
CMD ["dev"]
EXPOSE 8000
