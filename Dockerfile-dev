FROM node:22-bookworm AS node

WORKDIR /src
COPY . /src
RUN corepack enable
RUN yarn install --flat

FROM python:3.14

RUN mkdir -p /srv
WORKDIR /srv
COPY . /srv
COPY --from=node /src/dienst2/static/lib /srv/dienst2/static/lib
RUN pip install "poetry==2.2.1"

# Keep project dependencies out of Poetry's own environment. /opt/venv is not
# hidden by Docker Compose's /srv bind mount.
RUN python -m venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
RUN poetry install --no-root
RUN set -a && . ./dev.env && python manage.py collectstatic --noinput --no-post-process

ENTRYPOINT ["/srv/docker-entrypoint-dev.sh"]
CMD ["dev"]
EXPOSE 8000
